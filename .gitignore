# ── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
*.egg
.eggs/
dist/
build/
.venv/
venv/
venv*/
env/
ENV/
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# ── Environment / Secrets ──────────────────────────────────────────────────
.env
.env.*
# keep the placeholder template tracked (negation must be its own line —
# gitignore does NOT strip trailing comments)
!.env.example

# ── Auth credentials ───────────────────────────────────────────────────────
nginx/.htpasswd

# ── Docker ─────────────────────────────────────────────────────────────────
docker-compose.override.yml

# ── IDE ────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Logs / scratch dumps ───────────────────────────────────────────────────
*.log
logs/
agents_err.txt
agents_log.txt
last_err.txt
out.txt
pure_logs.txt
up_log.txt
*.bin

# ── Scratch / generated parser output ──────────────────────────────────────
# Ad-hoc dry-run dump at repo root. Canonical eval runs live under eval/runs/
# with explicit prd*_run*.json names and are NEVER matched by this.
out.json
# Redundant short-named mirror of eval/runs/. Canonical data lives in
# eval/runs/<batch>/; this convenience mirror is not version-controlled.
outputs/

# ── Database ───────────────────────────────────────────────────────────────
*.sqlite
*.db

# ── Alembic ────────────────────────────────────────────────────────────────
# Track all migration files — never ignore versions/
